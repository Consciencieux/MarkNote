    {"name": "help_open_title", "value": "ཁ་ཕྱེ་བ་དང་ཉར་ཚགས"},
    {"name": "help_open_body", "value": "གཙོ་ངོས་ནས་ཡིག་ཆ་གསར་བཟོ་ཡང་ན་ཡིག་ཆ་འདེམས་ཆོག ཉེར་སྤྱོད་གཞན་ནས་ཀྱང་རྒྱབ་སྐྱོར་ཡོད་པའི་ཡིག་ཆ་ཁ་ཕྱེ་ཐུབ། ཁ་ཕྱེ་བ་དང་ཉར་ཚགས་ཀྱི་ཡིག་ཆ་ 8 MiB ལས་བརྒལ་མི་ཆོག ཡིག་ཆ་རང་ལ་འབྲི་མི་ཐུབ་ན་མིང་གཞན་ནས་ཉར་ཆོག ཉར་ཚར་རྗེས་ཡིག་ཆ་གསར་པ་རྩོམ་སྒྲིག་མུ་མཐུད་བྱེད། ཉར་ཚགས་སྐབས་ཡིག་ཆ་རང་གི་ཨང་སྒྲིག་དང་། LF、CRLF、CR ཚེག་བརྗེ་སོར་འཇོག་བྱེད། ཡིག་ཆའི་ངོས་ནས་ད་ལྟའི་ནང་དོན་མཉམ་སྤྱོད་བྱེད་ཐུབ། ཉར་མེད་པའི་བཟོ་བཅོས་ཀྱང་ཚུད། མཉམ་སྤྱོད་བྱས་པ་ནི་གནས་སྐབས་འདྲ་བཤུས་ཡིན། ཡིག་ཆ་རང་ལ་ཉར་རྒྱུའམ་ཁེབས་རྒྱུ་མེད། སུབ་ན་ཡིག་ཆ་རང་རྒྱུད་ཁོངས་ཀྱི་ཕྱིར་སྡུད་སྒམ་དུ་སྤོ། ཉར་མེད་པའི་བཟོ་བཅོས་ཡོད་ན་བརྡ་སྟོན་བྱེད། དབང་ཆ་མི་འདང་བའམ་ཉེར་སྤྱོད་གཞན་གྱིས་ཡིག་ཆ་བཟོ་བཅོས་བྱས་ཡོད་ན་སུབ་མི་ཐུབ།"},
    {"name": "help_edit_title", "value": "རྩོམ་སྒྲིག་དང་སྔོན་ལྟ"},
    {"name": "help_edit_body", "value": "ཡིག་ཆའི་མཇུག་ནས་སྔོན་ལྟ་དང་། རྩོམ་སྒྲིག ས་བཅད་བརྗེ་ཆོག Markdown དང་ LaTeX ཡིག་ཆ་ལ་ས་བཅད་ཡོད། འཆར་ངོས་ཆེ་བའི་སྒྲིག་ཆས་སྟེང་ཁག་བགོས་བྱས་ནས་སྔོན་ལྟ་དང་རྩོམ་སྒྲིག་དུས་གཅིག་ཏུ་ལྟ་ཐུབ། ཡིག་ཆའི་ཐོ་གཞུང་དང་ཡིག་ཆ་གཤིབ་སྟོན་སྐབས། ཁ་བྱང་གི་མཐེབ་ནས་ཡིག་ཆ་ཆེར་སྐྱེད་པའམ་ཐོ་གཞུང་སླར་གསོ་བྱེད་ཐུབ། ཡིག་ཆའི་འདེམས་ཐོ་ནས་ཀྱང་ཡིག་ཆ་ཁ་རྒྱག་ཐུབ། ཡིག་ཆའི་ངོས་ཀྱི་དེ་ལས་མང་འདེམས་ཐོ་ནས་འཚོལ་བ་དང་། འཚོལ་བའི་བར་དུ་མདུན་རྒྱབ་མཆོང་བ། རེ་རེ་བཞིན་བརྗེ་བ་ཡོད།"},
    {"name": "help_format_title", "value": "རྒྱབ་སྐྱོར་ཡོད་པའི་རྣམ་གཞག"},
    {"name": "help_format_body", "value": "Markdown དང་། ཡི་གེ་རྐྱང་པ། SVG དང་ LaTeX ཡིག་ཆ་ལ་རྒྱབ་སྐྱོར་ཡོད། Markdown གྱིས་ཡིག་ཆ་དང་ཁུལ་གཅིག་པའམ་ནང་ཁུལ་གྱི་བརྙན་རིས་སྟོན་ཐུབ། རྒྱུད་ཁོངས་ཀྱིས་ཀློག་ཆོག་པ་ཁོ་ན་ཡིན། དྲ་ཐོག་གི་བརྙན་རིས་དང་དབང་ཆ་མེད་པའི་བརྙན་རིས་ལ་གནས་འཇོག་ཡི་གེ་ཁོ་ན་སྟོན། LaTeX ཀྱིས་ཡིག་ཆ་དང་རྩིས་ཚུལ་སྔོན་ལྟ་བྱེད་ཐུབ། PDF སྒྲིག་སྦྱོར་མི་བྱེད། བཀའ་བརྡ་ཁག་ཅིག་དང་། འདྲེན་པའི་བརྙན་རིས། TikZ རི་མོ་ད་དུང་སྟོན་མི་ཐུབ།"},
    {"name": "help_draft_title", "value": "ཟིན་བྲིས་དང་ཉེ་ཆར་གྱི་ཡིག་ཆ"},
    {"name": "help_draft_body", "value": "རྩོམ་སྒྲིག་སྐབས་སྒྲིག་ཆས་སྟེང་ཟིན་བྲིས་ཉར། ཡུལ་མེད་དུ་ཕྱིར་ཐོན་རྗེས་སླར་གསོ་བྱེད་ཆེད་ཡིན། དེའི་སྐབས་ཉེར་སྤྱོད་གཞན་ནས་ཡིག་ཆ་ཁ་ཕྱེ་ན། སྔོན་ལ་ཡིག་ཆའི་ངོས་སུ་ལོག་ནས་ཐེངས་སྔོན་མའི་རྩོམ་སྒྲིག་ཉར་རྒྱུ་ཡིན་མིན་འདྲི། དེ་ནས་ཡིག་ཆ་གསར་པ་ཁ་ཕྱེ། ཉེ་ཆར་གྱི་ཡིག་ཆ་ནི་རྒྱུན་གནས་དབང་ཆ་ཐོབ་ཟིན་པ་ཁོ་ན་སྟོན། དེ་ལས་མང་འདེམས་ཐོ་ནས་སྒྲིག་སྟངས་བཟོ་བཅོས་བྱེད་ཐུབ། ཡུན་རིང་མནན་ན་ཟིན་ཐོ་སུབ་ཐུབ། ཡིག་ཆའི་ངོས་ནས་བསྡུ་ཉར་བྱེད་པའམ་དོར་ཐུབ། གཙོ་ངོས་ཀྱི་སྟེང་ནས་བསྡུ་ཉར་ཐོ་གཞུང་ལ་བརྗེ་ཐུབ། ད་དུང་ཉར་མེད་པའམ་རྒྱུན་གནས་དབང་ཆ་མ་ཐོབ་པའི་ཡིག་ཆ་ནི་སྔོན་ལ་ཉར་ཚགས་སམ་མིང་གཞན་ནས་ཉར་རྗེས་གཞི་ནས་བསྡུ་ཉར་བྱེད་ཐུབ།"},
