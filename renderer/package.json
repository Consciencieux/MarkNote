{
  "name": "marknote-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/setup-tex-dependency.mjs && node scripts/setup-tikz-dependency.mjs",
    "prebuild": "node scripts/setup-tex-dependency.mjs --verify && node scripts/setup-tikz-dependency.mjs --verify",
    "build": "vite build && node scripts/package-assets.mjs",
    "predev": "node scripts/setup-tex-dependency.mjs --verify && node scripts/setup-tikz-dependency.mjs --verify",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "check:licenses": "node ../tools/generate-notices.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lezer/common": "1.5.3",
    "@lezer/lr": "1.4.11",
    "@mdit/plugin-katex": "1.1.4",
    "@mdit/plugin-tasklist": "1.1.3",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "mermaid": "11.16.1",
    "myst-to-html": "1.7.5",
    "tex-to-myst": "1.0.48",
    "vfile": "5.3.7"
  },
  "overrides": {
    "myst-to-html": {
      "markdown-it": "14.3.3"
    }
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "xml-formatter": "3.6.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
